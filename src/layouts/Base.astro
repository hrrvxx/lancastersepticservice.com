---
import Logo from '../components/Logo.astro';
import Icon from '../components/Icon.astro';
import LeadForm from '../components/LeadForm.astro';
import { site, tel, featuredServices } from '../data/site';
import { services } from '../data/services';
import { areas } from '../data/areas';
import { cityFromPath, serviceHref } from '../data/localServices';

interface Props {
  title: string;
  description: string;
  nav?: 'home' | 'about' | 'gallery' | 'services' | 'areas' | 'contact';
  image?: string;          // absolute path under /images for og:image
  schema?: object[];       // extra JSON-LD nodes for this page
  preloadHero?: boolean;
}
const { title, description, nav, image = '/images/og.jpg', schema = [], preloadHero = false } = Astro.props;
// build.format 'file' makes pathname end in .html; canonicals must match the clean URLs used in links and the sitemap.
const cleanPath = Astro.url.pathname.replace(/(index)?\.html$/, '').replace(/\/$/, '') || '/';
const canonical = new URL(cleanPath, site.url).href;

const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['Organization', 'HomeAndConstructionBusiness'],
      '@id': `${site.url}/#org`,
      description: site.description,
      priceRange: '$$',
      name: site.name,
      url: site.url,
      logo: `${site.url}/images/logo.png`,
      telephone: site.phoneTel,
      areaServed: areas.map(a => ({ '@type': 'City', name: a.name })), // areas already starts with the main city
    },
    { '@type': 'WebSite', '@id': `${site.url}/#website`, url: site.url, name: site.name, publisher: { '@id': `${site.url}/#org` } },
    ...schema,
  ],
};
const year = new Date().getFullYear();
// Inside a city (/service-areas/{city}[/...]) service links stay in that city.
const cityCtx = cityFromPath(Astro.url.pathname);
const cityName = cityCtx ? areas.find(a => a.slug === cityCtx)?.name : undefined;
const svcHref = (slug: string) => (cityCtx ? serviceHref(cityCtx, slug) : `/services/${slug}`);
const allServicesHref = cityCtx ? `/service-areas/${cityCtx}#services` : '/services';
---
<!DOCTYPE html>
<html lang="en-US">
<head>
  <meta charset="UTF-8" />
  <!-- RNR Stats (stats.dropservice.agency) -->
  <script is:inline src="https://stats.dropservice.agency/s.js" data-site="lancasterseptic" defer></script>
  <!-- Google tag (gtag.js) -->
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-XYB1KKGQG8"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-XYB1KKGQG8');
    // Count taps on any phone link as a call lead.
    document.addEventListener('click', function (e) {
      var a = e.target.closest && e.target.closest('a[href^="tel:"]');
      if (a) gtag('event', 'click_to_call', { link_url: a.getAttribute('href'), page_path: location.pathname });
    });
  </script>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon.png" type="image/png" />
  <meta name="theme-color" content="#111111" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content={site.name} />
  <meta property="og:locale" content="en_US" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL(image, site.url).href} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="stylesheet" href="/css/site.css" />
  {site.turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
  {preloadHero && <link rel="preload" as="image" imagesrcset="/images/hero-480w.webp 480w, /images/hero-800w.webp 800w, /images/hero.webp 1920w" imagesizes="100vw" fetchpriority="high" />}
  <script type="application/ld+json" set:html={JSON.stringify(graph)} />
</head>
<body>
  <a class="skip-link visually-hidden" href="#main-content">Skip to content</a>

  <header class="site-header" id="site-header">
    <div class="container header-inner">
      <a href="/" class="logo" aria-label={`${site.name} homepage`}><Logo height={42} /></a>
      <nav class="main-nav" id="main-nav" aria-label="Main navigation">
        <a href="/" aria-current={nav === 'home' ? 'page' : undefined}>Home</a>
        <a href="/about" aria-current={nav === 'about' ? 'page' : undefined}>About</a>
        <a href="/gallery" aria-current={nav === 'gallery' ? 'page' : undefined}>Gallery</a>
        <div class="nav-item nav-has-dropdown">
          <a href={allServicesHref} class="nav-services-trigger">Services <Icon name="chevron" /></a>
          <div class="nav-dropdown">
            {services.map(s => <a href={svcHref(s.slug)}>{s.name}</a>)}
            <a href={allServicesHref} class="nav-dropdown-all">{cityName ? `All Services in ${cityName}` : 'View All Services'} &rarr;</a>
          </div>
        </div>
        <a href="/contact" aria-current={nav === 'contact' ? 'page' : undefined}>Contact</a>
      </nav>
      <a href={tel} class="header-cta" aria-label={`Call ${site.phoneDisplay}`}><Icon name="phone" /> {site.phoneDisplay}</a>
      <button class="menu-toggle" id="menuToggle" aria-label="Open navigation menu" aria-expanded="false" aria-controls="main-nav">
        <span></span><span></span><span></span>
      </button>
    </div>
  </header>

  <main id="main-content">
    <slot />
  </main>

  <div class="mobile-fabs" aria-label="Quick contact buttons">
    <a href={tel} class="fab-btn fab-call" aria-label={`Call ${site.phoneDisplay}`}><Icon name="phone" /></a>
    <button type="button" class="fab-btn fab-form" data-open-quote aria-label="Get a Free Quote"><Icon name="chat" size={20} /></button>
  </div>
  <div class="quote-popup" id="quote-popup" role="dialog" aria-modal="true" aria-label="Get a Free Quote" hidden>
    <div class="quote-popup-backdrop" data-close-quote aria-hidden="true"></div>
    <div class="quote-popup-inner">
      <button type="button" class="quote-popup-close" data-close-quote aria-label="Close">&times;</button>
      <LeadForm id="popup-form" plain />
    </div>
  </div>

  <footer class="site-footer" role="contentinfo">
    <div class="container footer-inner">
      <div class="footer-brand">
        <a href="/" aria-label={`${site.name} homepage`} class="footer-logo"><Logo height={44} /></a>
        <p class="footer-tagline">{site.tagline}</p>
        <p class="footer-desc">Locally owned and operated, proudly pumping, inspecting and repairing septic systems for {cityName ?? site.city} and nearby communities. Quality guaranteed.</p>
        <a href={tel} class="footer-phone">{site.phoneDisplay}</a>
        <p class="footer-calltext">Call anytime.</p>
      </div>
      <nav class="footer-nav" aria-label="Quick links">
        <h3>Quick Links</h3>
        <ul>
          <li><a href="/">Home</a></li>
          <li><a href="/about">About</a></li>
          <li><a href={allServicesHref}>All Services</a></li>
          <li><a href="/gallery">Septic Work Gallery</a></li>
          <li><a href="/contact">Contact</a></li>
          <li><a href="/service-areas">Service Areas</a></li>
          <li><a href="/privacy">Privacy Policy</a></li>
          <li><a href="/terms">Terms of Service</a></li>
        </ul>
      </nav>
      <nav class="footer-services" aria-label="Services">
        <h3>Septic Services</h3>
        <ul>
          {featuredServices.slice(0, 5).map(slug => services.find(s => s.slug === slug)!).map(s => <li><a href={svcHref(s.slug)}>{s.name}</a></li>)}
          <li><a href={allServicesHref}>View All &rarr;</a></li>
        </ul>
      </nav>
      <div class="footer-contact">
        <h3>Contact</h3>
        <address>
          <p><Icon name="map" size={15} /> <span>Serving {cityName ?? site.city}, {site.state}</span></p>
          <p><Icon name="phone" /> <a href={tel}>{site.phoneDisplay}</a></p>
        </address>
      </div>
    </div>
    <nav class="container footer-areas" aria-label="Service areas">
      <h3><a href="/service-areas">Service Areas</a></h3>
      <ul>{areas.map(a => <li><a href={`/service-areas/${a.slug}`}>{a.name}</a></li>)}</ul>
    </nav>
    <div class="footer-bar">
      <div class="container">
        <p><span>&copy; {year} {site.name}. All rights reserved.</span> &nbsp;|&nbsp; <a href="/privacy">Privacy Policy</a> &nbsp;|&nbsp; <a href="/terms">Terms of Service</a></p>
      </div>
    </div>
  </footer>

  <script is:inline define:vars={{ endpoint: site.leadEndpoint, phoneTel: site.phoneTel, phoneDisplay: site.phoneDisplay }}>
    // Lead forms → /api/lead (Cloudflare Pages Function). Success is shown only when the server accepts the lead.
    (function () {
      var callLink = '<a href="tel:' + phoneTel + '">' + phoneDisplay + '</a>';
      document.querySelectorAll('form.lead-form').forEach(function (form) {
        var status = form.querySelector('.form-status');
        function clear() { if (status) { status.textContent = ''; status.className = 'form-status'; } }
        form.querySelectorAll('input[type="tel"]').forEach(function (input) {
          input.addEventListener('input', function () {
            var cleaned = input.value.replace(/[^0-9+()\-.\s]/g, '');
            if (cleaned !== input.value) input.value = cleaned;
            clear();
          });
        });
        form.querySelectorAll('input[name="lead_name"], textarea[name="lead_message"]').forEach(function (el) { el.addEventListener('input', clear); });
        function showError(msg, el) {
          if (status) { status.innerHTML = msg; status.className = 'form-status error'; }
          if (el) el.focus();
        }
        form.addEventListener('submit', function (e) {
          e.preventDefault();
          if (form.dataset.busy) return;
          var fd = new FormData(form);
          if (fd.get('website')) return;
          var name = String(fd.get('lead_name') || '').trim();
          var phone = String(fd.get('lead_phone') || '');
          var msg = String(fd.get('lead_message') || '').trim();
          var email = String(fd.get('lead_email') || '').trim();
          if (!name) return showError('Please enter your name.', form.querySelector('[name="lead_name"]'));
          if ((phone.match(/\d/g) || []).length < 10) return showError('Please enter a valid 10-digit phone number.', form.querySelector('[name="lead_phone"]'));
          if (email && !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) return showError('Please check your email address, or leave it blank.', form.querySelector('[name="lead_email"]'));
          if (!msg) return showError('Please tell us about your project.', form.querySelector('[name="lead_message"]'));
          form.dataset.busy = '1';
          var btn = form.querySelector('button[type="submit"]');
          var label = btn ? btn.innerHTML : '';
          if (btn) { btn.textContent = 'Sending…'; btn.disabled = true; }
          fetch(endpoint, {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ name: name, phone: phone, zip: String(fd.get('lead_zip') || '').trim(), email: email, message: msg, service: String(fd.get('lead_service') || ''), elapsed: Math.round(performance.now()), page: location.pathname, form: form.id, turnstile: String(fd.get('cf-turnstile-response') || '') }),
          })
            .then(function (r) { if (!r.ok) throw new Error('HTTP ' + r.status); })
            .then(function () {
              if (window.gtag) gtag('event', 'generate_lead', { form_id: form.id, service: String(fd.get('lead_service') || '') });
              form.innerHTML = '<div class="form-success"><svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="9 12 11 14 15 10"></polyline></svg><h3>Thank You!</h3><p>We received your request and will be in touch shortly.</p><p>Need help now? ' + callLink + '</p></div>';
            })
            .catch(function () {
              delete form.dataset.busy;
              var ts = form.querySelector('.cf-turnstile');
              if (ts && window.turnstile) window.turnstile.reset(ts);
              if (btn) { btn.innerHTML = label; btn.disabled = false; }
              showError('Sorry, we could not send your request. Please call ' + callLink + '.');
            });
        });
      });
    })();
  </script>
  <script is:inline>
    (function () {
      var toggle = document.getElementById('menuToggle');
      var nav = document.getElementById('main-nav');
      if (!toggle || !nav) return;
      function closeMenu() {
        nav.classList.remove('nav-open');
        toggle.classList.remove('is-open');
        toggle.setAttribute('aria-expanded', 'false');
        nav.querySelectorAll('.nav-has-dropdown').forEach(function (d) { d.classList.remove('nav-dropdown-open'); });
      }
      toggle.addEventListener('click', function (e) {
        e.stopPropagation();
        var open = nav.classList.toggle('nav-open');
        toggle.classList.toggle('is-open', open);
        toggle.setAttribute('aria-expanded', String(open));
      });
      document.addEventListener('click', function (e) { if (!toggle.contains(e.target) && !nav.contains(e.target)) closeMenu(); });
      nav.querySelectorAll('a:not(.nav-services-trigger):not(.nav-areas-trigger)').forEach(function (a) {
        a.addEventListener('click', function () { if (window.innerWidth <= 1024) closeMenu(); });
      });
      nav.querySelectorAll('.nav-services-trigger, .nav-areas-trigger').forEach(function (trigger) {
        var parent = trigger.closest('.nav-has-dropdown');
        trigger.addEventListener('click', function (e) {
          if (window.innerWidth <= 1024) { e.preventDefault(); e.stopPropagation(); parent.classList.toggle('nav-dropdown-open'); }
        });
      });
    })();
    (function () {
      var FOCUSABLE = 'a[href],button:not([disabled]),input:not([disabled]),select:not([disabled]),textarea:not([disabled]),[tabindex]:not([tabindex="-1"])';
      var popup = document.getElementById('quote-popup');
      var opener = null;
      function focusables() { return Array.prototype.slice.call(popup.querySelector('.quote-popup-inner').querySelectorAll(FOCUSABLE)); }
      function open() {
        opener = document.activeElement;
        popup.hidden = false;
        document.body.style.overflow = 'hidden';
        var f = focusables()[0];
        if (f) setTimeout(function () { f.focus(); }, 0);
      }
      function close() {
        popup.hidden = true;
        document.body.style.overflow = '';
        if (opener && opener.focus) opener.focus();
        opener = null;
      }
      document.querySelectorAll('[data-open-quote]').forEach(function (b) { b.addEventListener('click', open); });
      document.querySelectorAll('[data-close-quote]').forEach(function (b) { b.addEventListener('click', close); });
      document.addEventListener('keydown', function (e) {
        if (popup.hidden) return;
        if (e.key === 'Escape') return close();
        if (e.key !== 'Tab') return;
        var f = focusables();
        if (!f.length) return e.preventDefault();
        if (e.shiftKey && document.activeElement === f[0]) { e.preventDefault(); f[f.length - 1].focus(); }
        else if (!e.shiftKey && document.activeElement === f[f.length - 1]) { e.preventDefault(); f[0].focus(); }
      });
    })();
  </script>
</body>
</html>
