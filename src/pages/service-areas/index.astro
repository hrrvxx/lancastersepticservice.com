---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Cta from '../../components/Cta.astro';
import { areas } from '../../data/areas';
import { home } from '../../data/home';
import { site, withBrand } from '../../data/site';
---
<Base title={withBrand('Service Areas Near Lancaster, CA')} description="Septic tank pumping and repair across the Antelope Valley: Lancaster, Palmdale, Quartz Hill, Rosamond, Littlerock, Acton, Leona Valley and more." nav="areas">
  <PageHero title="Serving Lancaster & the Antelope Valley" sub="Need septic pumping anywhere in the Antelope Valley? Our locally owned crew pumps, inspects and repairs septic systems across these communities." image="gallery-5" crumbs={[{ label: 'Service Areas' }]} />
  <section class="section">
    <div class="container">
      <div class="section-header" style="max-width:760px;">{home.areasIntro.map(p => <p class="section-sub">{p}</p>)}</div>
      <div class="services-grid">
        {areas.map(a => (
          <a href={`/service-areas/${a.slug}`} class="service-card" style="text-decoration:none;display:block;color:inherit;">
            <div class="card-body">
              <h3 style="margin:0 0 8px;font-size:16px;">{a.name}</h3>
              <p style="margin:0;font-size:14px;color:var(--text-light);line-height:1.6;">{a.summary}</p>
              <p style="margin:8px 0 0;font-size:13px;color:var(--text-mid);"><strong>ZIP codes:</strong> {a.zips.join(', ')}</p>
              <span class="card-link" style="margin-top:12px;display:inline-flex;align-items:center;gap:6px;">Learn More &rarr;</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
  <Cta />
</Base>
