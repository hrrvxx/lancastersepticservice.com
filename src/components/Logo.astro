---
// Vector logo: water drop with a check mark + "LANCASTER / SEPTIC SERVICE" wordmark.
interface Props { height?: number; class?: string }
const { height = 44, class: cls } = Astro.props;
---
<svg class={cls} height={height} viewBox="0 0 268 64" role="img" aria-label="Lancaster Septic Service" xmlns="http://www.w3.org/2000/svg">
  <path d="M24 3C15 15 5 27 5 39a19 19 0 0 0 38 0C43 27 33 15 24 3z" fill="#3B9AE1" />
  <polyline points="15,40 22,47 34,33" fill="none" stroke="#fff" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" />
  <text x="56" y="26" fill="#3B9AE1" font-family="Poppins, system-ui, sans-serif" font-weight="700" font-size="17" textLength="150" lengthAdjust="spacing">LANCASTER</text>
  <text x="55" y="58" fill="#fff" font-family="Poppins, system-ui, sans-serif" font-weight="800" font-size="21" textLength="208" lengthAdjust="spacingAndGlyphs">SEPTIC SERVICE</text>
</svg>
