---
import type { Faq } from '../data/types';
interface Props { faqs: Faq[]; eyebrow?: string; sub?: string }
const { faqs, eyebrow = 'Frequently Asked Questions', sub } = Astro.props;
---
<section class="section faq-section" aria-labelledby="faq-heading">
  <div class="container faq-container">
    <div class="section-header">
      <p class="eyebrow">{eyebrow}</p>
      <h2 id="faq-heading">Frequently Asked Questions</h2>
      {sub && <p class="section-sub">{sub}</p>}
    </div>
    <div class="faq-list">
      {faqs.map(f => (
        <details class="faq-item">
          <summary><span>{f.q}</span><span class="faq-icon" aria-hidden="true"></span></summary>
          <div class="faq-body"><p>{f.a}</p></div>
        </details>
      ))}
    </div>
  </div>
</section>
