---
import { site } from '../data/site';
import { services } from '../data/services';
import { areas } from '../data/areas';
// compact (default, every form): paired fields, short labels, 2-line message, one-line note. compact={false} = legacy tall form.
interface Props { id: string; heading?: string; large?: boolean; plain?: boolean; compact?: boolean }
const { id, heading = 'Get a <em>Free Quote</em>', large = false, plain = false, compact = true } = Astro.props;
// Preselect the service on /services/{slug} and /service-areas/{city}/{slug} pages.
const pathSlug = Astro.url.pathname.replace(/\.html$/, '').split('/').filter(Boolean).pop();
const current = services.find(s => s.slug === pathSlug)?.name;
// Local-looking placeholders: the site area code and the main city's first ZIP.
const phonePlaceholder = `${site.phoneDisplay.slice(0, 5)} 000-0000`;
const zipPlaceholder = areas[0]?.zips[0] ?? '';
---
<div class:list={['form-card', { 'form-card--lg': large, 'form-card--compact': compact }]} style={plain ? 'box-shadow:none;border:none;padding:0;' : undefined}>
  <div class="form-card-header"><h3 set:html={heading} /></div>
  <form id={id} class="lead-form" method="POST" novalidate>
    <div class="hp-wrap" aria-hidden="true">
      <label for={`hp_${id}`}>Website</label>
      <input type="text" id={`hp_${id}`} name="website" tabindex="-1" autocomplete="off" placeholder="https://" />
    </div>
    <div class:list={[{ 'form-row': compact }]}>
    <div class="form-group">
      <label for={`${id}_name`}>Your Name *</label>
      <input type="text" id={`${id}_name`} name="lead_name" placeholder="John Smith" required autocomplete="name" />
    </div>
    <div class="form-group">
      <label for={`${id}_phone`}>Phone Number *</label>
      <input type="tel" id={`${id}_phone`} name="lead_phone" placeholder={phonePlaceholder} required autocomplete="tel" inputmode="tel" pattern="[0-9+()\-.\s]{7,}" />
    </div>
    </div>
    <div class="form-group">
      <label for={`${id}_email`}>Email <span class="label-hint">{compact ? '(optional)' : '(optional, for your confirmation)'}</span></label>
      <input type="email" id={`${id}_email`} name="lead_email" placeholder="you@example.com" autocomplete="email" inputmode="email" maxlength="254" />
    </div>
    <div class:list={[{ 'form-row': compact }]}>
    <div class="form-group">
      <label for={`${id}_service`}>Service Needed</label>
      <select id={`${id}_service`} name="lead_service">
        <option value="" selected={!current}>Select a service</option>
        {services.map(s => <option value={s.name} selected={s.name === current}>{s.name}</option>)}
        <option value="Other / Not sure">Other / Not sure</option>
      </select>
    </div>
    <div class="form-group">
      <label for={`${id}_zip`}>ZIP Code</label>
      <input type="text" id={`${id}_zip`} name="lead_zip" placeholder={zipPlaceholder} autocomplete="postal-code" inputmode="numeric" maxlength="10" />
    </div>
    </div>
    <div class="form-group">
      <label for={`${id}_message`}><span>How Can We Help?</span> *</label>
      <textarea id={`${id}_message`} name="lead_message" placeholder="Pumping due, slow drains, backup, escrow inspection..." required rows={compact ? 2 : 3}></textarea>
    </div>
    {site.turnstileSiteKey && <div class="cf-turnstile" data-sitekey={site.turnstileSiteKey} data-appearance="interaction-only" data-size="flexible"></div>}
    <button type="submit" class="btn-submit"><span>Get a Free Quote</span></button>
    {compact
      ? <p class="form-note"><span>No obligation. By submitting, you agree we may call, text or email you. <a href="/privacy">Privacy</a></span></p>
      : <p class="form-note"><span>Free repair quotes, no obligation. By submitting, you agree we may call, text or email you about your project. See our <a href="/privacy">Privacy Policy</a>.</span></p>}
    <div class="form-status" role="alert" aria-live="polite"></div>
  </form>
</div>
